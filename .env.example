# docker-compose.yml reads this file. Copy it to .env and fill it in.

# The domain the relay serves; tunnels live at <name>.$TUNR_DOMAIN.
TUNR_DOMAIN=tunnel.example.com
# At least 32 random characters: openssl rand -hex 32
TUNR_JWT_SECRET=
# Postgres password for the bundled database.
POSTGRES_PASSWORD=

# ── Agent Bridge (optional) ──
# TUNR_BRIDGE_ENABLED=1
# Ed25519 seed for grant signing: openssl rand -base64 32
# TUNR_GRANT_SIGNING_KEY=
# The URL connectors and agents dial; defaults to https://relay.$TUNR_DOMAIN.
# TUNR_BRIDGE_PUBLIC_URL=https://tunnel.example.com
# Where grant e-mails link to. The built-in portal routes by fragment:
# TUNR_BRIDGE_PORTAL_URL=https://tunnel.example.com/portal/#
# Sign-in links for /portal/ are e-mailed via Resend:
# RESEND_API_KEY=
# RESEND_FROM=tunr <noreply@example.com>
